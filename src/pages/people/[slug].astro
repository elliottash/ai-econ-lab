---
import Base from '../../layouts/Base.astro';
import { PEOPLE, personBySlug, GROUP_LABELS } from '../../data/people';
import { LAB } from '../../data/lab';

export function getStaticPaths() {
  return PEOPLE.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const person = personBySlug(slug!);
if (!person) {
  throw new Error(`Unknown person slug: ${slug}`);
}

const statusLabel = GROUP_LABELS[person.group];
const profileLinks = [
  { href: person.scholar, text: 'Google Scholar' },
  { href: person.github, text: 'GitHub' },
  { href: person.x, text: 'X' },
].filter(link => link.href);
---
<Base title={person.name} description={`${person.name} — ${person.role}, ${LAB.name}.`}>
  <section class="page-hero shell person-hero">
    <div>
      <p class="eyebrow">{statusLabel}</p>
      <h1>{person.name}</h1>
      <p class="lede">{person.role} · {LAB.name}</p>
      <div class="actions">
        {person.url && <a class="button primary" href={person.url} target="_blank" rel="noopener">Personal site</a>}
        {profileLinks.map(link => <a class="button secondary" href={link.href} target="_blank" rel="noopener">{link.text}</a>)}
        {person.email && <a class="button secondary" href={`mailto:${person.email}`}>{person.email}</a>}
        <a class="button secondary" href="/people/">All people</a>
      </div>
    </div>
    {person.photo && (
      <img
        class="person-photo"
        src={person.photo}
        alt={`Portrait of ${person.name}`}
        width="208"
        height="260"
      />
    )}
  </section>

  {person.bio && (
    <section class="section alt">
      <div class="shell" style="max-width:720px;">
        <p class="section-intro" style="font-size:1.1rem;">{person.bio}</p>
      </div>
    </section>
  )}
</Base>
