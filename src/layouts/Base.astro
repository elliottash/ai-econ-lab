---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { LAB } from '../data/lab';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = LAB.name,
  description = LAB.mission,
  noindex = false,
} = Astro.props;

const pageTitle = title === LAB.name ? title : `${title} — ${LAB.short_name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const footerLinks = [
  { href: '/people/', text: 'People' },
  { href: '/research/', text: 'Research' },
  { href: '/grants/', text: 'Grants' },
  { href: 'https://chat.ai-econ-lab.org/', text: 'Internal Chat' },
  { href: `mailto:${LAB.email}`, text: LAB.email },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fafbfc" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/assets/mark.svg" type="image/svg+xml" />
  <title>{pageTitle}</title>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <nav class="nav shell" aria-label="Primary navigation">
      <a class="brand" href="/">
        <span class="brand-word">AI <em>&amp;</em> Economics Lab</span>
        <span class="brand-lab">at ETH Zurich</span>
      </a>
      <div class="nav-links">
        <a href="/people/">People</a>
        <a href="/research/">Research</a>
        <a href="/grants/">Grants</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="footer-grid shell">
      <div>
        <p><strong>{LAB.name}</strong></p>
        <p class="small">{LAB.tagline} · <span class="nowrap">{LAB.location}</span></p>
      </div>
      <p class="prose-links">
        {footerLinks.map((link, i) => <>{i > 0 && ' · '}<a href={link.href}>{link.text}</a></>)}
      </p>
    </div>
  </footer>
</body>
</html>
